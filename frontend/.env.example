# Copy this file to .env.local for local development.
# Do not commit .env.local.
NEXT_PUBLIC_API_URL=http://your-backend-host
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# PWA is disabled in development by default to avoid repeated Workbox GenerateSW warnings.
# Set this to true only when you intentionally want to test PWA in next dev.
NEXT_ENABLE_PWA_DEV=false
